# ============================================================
# .env — Biến môi trường cho web
# COPY file này thành .env và điền thông tin thực tế
# ============================================================

# ─── API Security ─────────────────────────────────────────
# Master API key (Admin) — đặt chuỗi ngẫu nhiên dài, khó đoán
# Tạo ngẫu nhiên: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VIETAUTO_API_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY

# ─── Database ─────────────────────────────────────────────
# MongoDB URI (local hoặc MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/vietauto_db
# Hoặc dùng Atlas: mongodb+srv://user:pass@cluster.mongodb.net/vietauto_db

# ─── Flask ────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0

# ─── Proxy (tuỳ chọn) ─────────────────────────────────────
# Nếu VPS bị chặn truy cập Google, dùng proxy
# DEFAULT_PROXY_URL=http://user:pass@proxy-host:port
