[Unit]
Description=VietAuto API Server (Gunicorn)
After=network.target

[Service]
# === Thay YOUR_USER bằng user Linux của bạn trên VPS ===
User=YOUR_USER
Group=www-data

# === Thay đường dẫn phù hợp với nơi bạn upload project ===
WorkingDirectory=/home/YOUR_USER/tool_veo_3

# Kích hoạt virtualenv trước khi chạy gunicorn
Environment="PATH=/home/YOUR_USER/tool_veo_3/venv/bin"

# Biến môi trường cho API server
EnvironmentFile=/home/YOUR_USER/tool_veo_3/.env

# Lệnh khởi động Gunicorn
ExecStart=/home/YOUR_USER/tool_veo_3/venv/bin/gunicorn \
    --config /home/YOUR_USER/tool_veo_3/deploy/gunicorn.conf.py \
    "web.run:app"

# Restart tự động khi crash
Restart=on-failure
RestartSec=5s

# Log ra stdout (systemd sẽ bắt)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=web

[Install]
WantedBy=multi-user.target
